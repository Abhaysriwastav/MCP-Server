# Workspace & storage
VIDEO_MCP_WORKSPACE_DIR=./workspace
VIDEO_MCP_DB_PATH=./workspace/video_mcp.db
VIDEO_MCP_ALLOWED_LOCAL_ROOTS=.

# Media binaries (resolved from PATH if omitted)
VIDEO_MCP_FFMPEG_BIN=ffmpeg
VIDEO_MCP_FFPROBE_BIN=ffprobe
VIDEO_MCP_FFMPEG_TIMEOUT_SEC=600

# Mixed source download limits
VIDEO_MCP_MAX_DOWNLOAD_MB=1024
VIDEO_MCP_DOWNLOAD_TIMEOUT_SEC=120
VIDEO_MCP_ALLOW_PRIVATE_URLS=false

# YouTube & Whisper transcription / captioning
VIDEO_MCP_WHISPER_MODEL=base
VIDEO_MCP_WHISPER_DEVICE=cpu
VIDEO_MCP_WHISPER_COMPUTE_TYPE=int8
VIDEO_MCP_YOUTUBE_MAX_DURATION_SEC=7200
VIDEO_MCP_SUBTITLE_MAX_WORDS_PER_LINE=6

# AI Voice Cloning (omnivoice | coqui | elevenlabs)
VIDEO_MCP_VOICE_PROVIDER=omnivoice
VIDEO_MCP_OMNIVOICE_MODEL=k2-fsa/OmniVoice
VIDEO_MCP_OMNIVOICE_DEVICE=cpu
VIDEO_MCP_COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
VIDEO_MCP_ELEVENLABS_API_KEY=
VIDEO_MCP_ELEVENLABS_VOICE_ID=

# Publishing
VIDEO_MCP_RELEASE_DIR=./workspace/releases
VIDEO_MCP_WEBHOOK_URL=

# Transport: stdio | streamable-http
VIDEO_MCP_TRANSPORT=stdio
VIDEO_MCP_HOST=127.0.0.1
VIDEO_MCP_PORT=8000

